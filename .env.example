# 复制为 .env 并填入你的密钥
# DeepSeek(OpenAI 兼容)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Anthropic(可选,用于 strong 档)
ANTHROPIC_API_KEY=

# OpenAI(可选,若 strong 用 OpenAI)
OPENAI_API_KEY=

# Semantic Scholar(可选,免费 key 可显著降低 429 限流;申请:https://www.semanticscholar.org/product/api)
SEMANTIC_SCHOLAR_API_KEY=

# 可选:覆盖 config.yaml 中的模型
THESIS_STRONG_MODEL=
THESIS_MEDIUM_MODEL=
THESIS_CHEAP_MODEL=
